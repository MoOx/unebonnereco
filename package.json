{
  "name": "unebonnereco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Catalogue of cultural recommendations from the Un Bon Moment podcast",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "fetch": "node src/steps/01-fetch.ts",
    "transcript": "node src/steps/02-transcript.ts",
    "target": "node src/steps/03-target.ts",
    "whisper": "node src/steps/03b-whisper.ts",
    "extract": "node src/steps/04-extract.ts",
    "enrich": "node src/steps/05-enrich.ts",
    "typecheck": "tsc --noEmit",
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "expo": "^57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  }
}
